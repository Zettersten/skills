<?xml version="1.0" encoding="ISO-8859-1"?>
<Root_Element ID="DAOCUi">

  <!-- Player vitals window, slot 2. Loaded from my assets.xml, opened with ToggleCustom2. -->

  <WindowTemplate>
    <Name>custom2_window</Name>
    <WindowId>Vitals</WindowId>
    <CloseButton>true</CloseButton>
    <MoveButton>true</MoveButton>
    <TopRightResizeButton>false</TopRightResizeButton>
    <BottomRightResizeButton>true</BottomRightResizeButton>
    <BottomLeftResizeButton>false</BottomLeftResizeButton>
    <ResizeButtonOffsetX>0</ResizeButtonOffsetX>
    <ResizeButtonOffsetY>0</ResizeButtonOffsetY>
    <TitleWidth>160</TitleWidth>
    <TitleHeight>12</TitleHeight>
    <Width>160</Width>
    <Height>60</Height>
    <ResizeableWidth>5</ResizeableWidth>
    <ResizeableHeight>0</ResizeableHeight>
    <ResizeableTwoWayWidth>0</ResizeableTwoWayWidth>
    <ResizeableTwoWayHeight>0</ResizeableTwoWayHeight>
    <MinWidth>4</MinWidth>
    <MinHeight>60</MinHeight>
    <ContextTemplateName></ContextTemplateName>

    <!-- name -->
    <LabelDef>
      <ControlId></ControlId>
      <Position>
        <X>0</X>
        <Y>3</Y>
      </Position>
      <Alignment>
        <GrowWidth>true</GrowWidth>
      </Alignment>
      <Color>
        <R>255</R>
        <G>192</G>
        <B>0</B>
        <A>255</A>
      </Color>
      <FontName>arial11</FontName>
      <Width>160</Width>
      <Height>12</Height>
      <ColorAdapter></ColorAdapter>
      <MaxCharacters>32</MaxCharacters>
      <Data></Data>
      <EndAligned>false</EndAligned>
      <TextCentered>true</TextCentered>
      <Adapter>summary_title</Adapter>
    </LabelDef>

    <!-- health bar -->
    <StatusBarDef>
      <ControlId></ControlId>
      <Position>
        <X>8</X>
        <Y>20</Y>
      </Position>
      <Alignment>
        <GrowWidth>true</GrowWidth>
      </Alignment>
      <TemplateName>statusbar_red</TemplateName>
      <AdapterName>Summary_Player_Hits</AdapterName>
      <Width>110</Width>
    </StatusBarDef>

    <ScalarLabelDef>
      <ControlId></ControlId>
      <Position>
        <X>122</X>
        <Y>18</Y>
      </Position>
      <Alignment>
        <OffsetRight>true</OffsetRight>
      </Alignment>
      <FontName>arial11</FontName>
      <Adapter>summary_player_hits</Adapter>
      <ColorAdapter></ColorAdapter>
      <Width>30</Width>
      <Height>14</Height>
      <MaxCharacters>4</MaxCharacters>
      <Color>
        <R>255</R>
        <G>255</G>
        <B>255</B>
        <A>255</A>
      </Color>
      <Data></Data>
      <EndAligned>true</EndAligned>
      <TextCentered>false</TextCentered>
    </ScalarLabelDef>

    <!-- power bar -->
    <StatusBarDef>
      <ControlId></ControlId>
      <Position>
        <X>8</X>
        <Y>36</Y>
      </Position>
      <Alignment>
        <GrowWidth>true</GrowWidth>
      </Alignment>
      <TemplateName>statusbar_blu</TemplateName>
      <AdapterName>summary_player_power</AdapterName>
      <Width>110</Width>
    </StatusBarDef>

    <ScalarLabelDef>
      <ControlId></ControlId>
      <Position>
        <X>122</X>
        <Y>34</Y>
      </Position>
      <Alignment>
        <OffsetRight>true</OffsetRight>
      </Alignment>
      <FontName>arial11</FontName>
      <Adapter>summary_player_power</Adapter>
      <ColorAdapter></ColorAdapter>
      <Width>30</Width>
      <Height>14</Height>
      <MaxCharacters>4</MaxCharacters>
      <Color>
        <R>255</R>
        <G>255</G>
        <B>255</B>
        <A>255</A>
      </Color>
      <Data></Data>
      <EndAligned>true</EndAligned>
      <TextCentered>false</TextCentered>
    </ScalarLabelDef>

    <!-- background -->
    <FullResizeImageDef>
      <ControlId></ControlId>
      <Position>
        <X>0</X>
        <Y>0</Y>
      </Position>
      <Alignment>
        <GrowWidth>true</GrowWidth>
        <GrowHeight>true</GrowHeight>
      </Alignment>
      <TemplateName>fresizeimage_dlg_bg_small</TemplateName>
      <Width>160</Width>
      <Height>60</Height>
    </FullResizeImageDef>

  </WindowTemplate>

</Root_Element>
