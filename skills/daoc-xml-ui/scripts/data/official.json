  "pperdoll.bmp": "Inventory", "hldbrite.bmp": "Inventory", "sacks.bmp": "Inventory",
  "magicsheet.bmp": "Spells", "combstylesheet.bmp": "Styles", "skillsheet.bmp": "Abilities",
  "trade.bmp": "Trade", "interact.bmp": "Tradeskills", "edit_box.bmp": "Housing market query",
